#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
python="${XDG_DATA_HOME:-$HOME/.local/share}/omawhisper/venv/bin/python"
if [[ ! -x "$python" ]]; then
  python=python3
fi
export PYTHONPATH="$root/backend${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -m omawhisper.cli "$@"
